# Dexter3 Grok v1.0 scalper — LIVE lane on the VM (OpenAPI daemon transport, demo 9922808).
# The cutover target: this replaces the PC-hosted lane so the PC can power off.
# SAFETY: never run this live at the same time as the PC-hosted lane or the
# paper unit on the same label — one host per label at a time (double-trade
# risk). MIN_VOLUME_RISK_RATIO_CAP + governor loss-stop preserved from PC.
[Unit]
Description=Dexter3 Grok v1.0 scalper LIVE lane (OpenAPI daemon)
After=network-online.target dexter3-openapi-daemon.service
Wants=dexter3-openapi-daemon.service

[Service]
Type=simple
WorkingDirectory=/opt/dexter_pro
MemoryMax=200M
Restart=always
RestartSec=15
Environment=PYTHONUNBUFFERED=1
Environment=DEXTER3_TRANSPORT=openapi
Environment=DEXTER3_OPENAPI_DAEMON_URL=http://127.0.0.1:9877
Environment=DEXTER3_LIVE=1
Environment=DEXTER3_HUNT=1
Environment=DEXTER3_FAST_TICK_SEC=8
Environment=DEXTER3_CAPITAL_USD=1000
Environment=DEXTER3_MIN_VOLUME_RISK_RATIO_CAP=1.5
Environment=DEXTER3_MODE=grok
Environment=DEXTER3_DAILY_TARGET_USD=30
Environment=DEXTER3_DAILY_LOSS_USD=15
Environment=DEXTER3_BASE_RISK_FRAC=0.004
Environment=DEXTER3_MAX_RISK_FRAC=0.010
ExecStart=/opt/dexter_pro/.venv/bin/python -X utf8 -m dexter3.shadow_runner --symbols XAUUSD --loop --poll-sec 20 --live --grok

[Install]
WantedBy=multi-user.target
