# Dexter3 Grok v1.0 scalper — LIVE lane on the VM (OpenAPI daemon transport, demo 9922808).
# The cutover target: this replaces the PC-hosted lane so the PC can power off.
# SAFETY: never run this live at the same time as the PC-hosted lane or the
# paper unit on the same label — one host per label at a time (double-trade
# risk). Governor loss-stop preserved from PC.
# 2026-07-10 cutover fix: DEXTER3_MAX_VOLUME_UNITS=10 was DROPPED from the PC
# launcher during unit creation -> fell back to the 0.05 BTC-scale default ->
# every XAU entry refused (min_volume_exceeds_max_volume_units_cap; XAU
# minVolume=1 oz). Restored to PC value 10. Ratio cap loosened to 0 (off) per
# owner directive; per-trade risk stays bounded by the governor cap
# (max_risk_frac 1% = $10). Revert cap to 1.5 for PC-parity if micro setups
# underperform.
[Unit]
Description=Dexter3 Grok v1.0 scalper LIVE lane (OpenAPI daemon)
After=network-online.target dexter3-openapi-daemon.service
Wants=dexter3-openapi-daemon.service

[Service]
Type=simple
WorkingDirectory=/opt/dexter_pro
MemoryMax=200M
Restart=always
RestartSec=15
Environment=PYTHONUNBUFFERED=1
Environment=DEXTER3_TRANSPORT=openapi
Environment=DEXTER3_OPENAPI_DAEMON_URL=http://127.0.0.1:9877
Environment=DEXTER3_LIVE=1
Environment=DEXTER3_HUNT=1
Environment=DEXTER3_FAST_TICK_SEC=8
Environment=DEXTER3_CAPITAL_USD=1000
Environment=DEXTER3_MAX_VOLUME_UNITS=10
Environment=DEXTER3_MIN_VOLUME_RISK_RATIO_CAP=0
# 2026-07-10 negative-skew plug: floored 1oz trades pay tight-stop risk only
# (disaster widening reverted at the floor — code default ON) + hard $ ceiling
Environment=DEXTER3_MIN_VOLUME_RISK_ABS_CAP_USD=9
Environment=DEXTER3_MODE=grok
Environment=DEXTER3_DAILY_TARGET_USD=30
Environment=DEXTER3_DAILY_LOSS_USD=15
Environment=DEXTER3_BASE_RISK_FRAC=0.004
Environment=DEXTER3_MAX_RISK_FRAC=0.010
# --- PC-launcher parity (proven config); consolidated 2026-07-16, see the
# fable unit's note. Grok bypasses v16, so only the OM/exit + entry-cadence
# envs apply. SMART_EXIT off (PC parity) — same fast-close/repair-preempt bug.
Environment=DEXTER3_SMART_EXIT_ENABLED=0
Environment=DEXTER3_MAX_ENTRIES_PER_DAY=60
Environment=DEXTER3_DAILY_LOSS_BASKETS=3
Environment=DEXTER3_OM_LADDER_CSV=0.25:0.02,0.50:0.15,0.80:0.40,1.20:0.80,2.00:1.45,3.00:2.25
Environment=DEXTER3_ANTICHASE_ENABLED=1
Environment=DEXTER3_PULLBACK_ENABLED=1
# VM-intentional (post-cutover): shadow observers + weekend safety
Environment=DEXTER3_PA_EYE=shadow
Environment=DEXTER3_WEEKEND_FLATTEN_ENABLED=1
# 2026-07-16 twin-entry plug (see fable unit's note): grok shares fable's
# producer, so its entries duplicated fable's same-side risk within minutes.
# DOWNSIZE not skip — owner rule: no hard blockers on demo; grok keeps trading
# (its own A/B sample stays valid), at half risk when it is the follower.
Environment=DEXTER3_CROSS_LANE_DEDUP=downsize
# 2026-07-16 owner order: day-open bias DOWNSIZE + close/reopen entry pause
# ported from the VP research (two-window proven on the shared hunt
# producer). NO limit-entry here: that layer was proven against ladder/convex
# exits only — grok's scalp small-lock exits were never measured with it.
Environment=DEXTER3_HUNT_DAYOPEN_BIAS=skip
Environment=DEXTER3_HUNT_BIAS_ANCHOR_HOUR=0
Environment=DEXTER3_HUNT_BIAS_MIN_HOURS=1
Environment=DEXTER3_HUNT_BIAS_DOWNSIZE_MULT=0.25
Environment=DEXTER3_HUNT_NO_TRADE_UTC=20:45-22:15
ExecStart=/opt/dexter_pro/.venv/bin/python -X utf8 -m dexter3.shadow_runner --symbols XAUUSD --loop --poll-sec 20 --live --grok

[Install]
WantedBy=multi-user.target
