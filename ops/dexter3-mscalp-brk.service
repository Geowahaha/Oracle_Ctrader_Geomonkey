# Dexter3 MSCALP-BRK lane — the blue-sky entry twin (owner observation
# 2026-08-07: "USTEC Buy ที่แนวต้าน และ Sell ที่แนวรับ ... Make a new lane
# to improve the entry").
#
# DATA CONFIRMED THE EYE: the observed-window losers entered 0.06xATR from
# the nearest M15 level (selling INTO support); the winners had 4.0-4.6xATR
# of air. Sweep on 9000 real M5 bars / 689 signals / T15 exits / 60-40
# split: graded headroom gates stayed derive-negative, but BRK — take the
# impulse ONLY when the entry close is beyond EVERY M15 pivot on its side
# (blue sky, binary, nothing to tune) — was the ONLY both-segments-positive
# cell: derive +168 PF 1.10 / validate +364 PF 1.38 (vs BASE -1018/+302).
#
# WHAT: identical mscalp producer + knobs; decide_mscalp_brk gates the
# entry by M15 pivots AGGREGATED FROM THE M5 PREFIX (replay/live share the
# state model by construction); blocked signals journal as sr_wall skips.
# EXITS IDENTICAL to dexter3-mscalp (bank 0.5R / 15-min / SL 1.3xATR) so
# the A/B vs the original isolates exactly one variable: THE ENTRY.
# Trial tier un-gated per the standing owner order 2026-08-06 ("เทสต้อง
# เดินต่อ bypass ทุกเงื่อนไข") — restore caps before any real-money move.
# JUDGE: N>=30 broker deals in DOLLARS vs mscalp; no tuning mid-trial.
#
# ACTIVATION (start ONLY this unit):
#   sudo cp ops/dexter3-mscalp-brk.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now dexter3-mscalp-brk
[Unit]
Description=Dexter3 MSCALP-BRK lane LIVE canary USTEC (blue-sky M15 entry gate on mscalp signals, T15 exits)
After=network-online.target dexter3-openapi-daemon.service
Wants=dexter3-openapi-daemon.service

[Service]
Type=simple
WorkingDirectory=/opt/dexter_pro
MemoryMax=200M
Restart=always
RestartSec=15
Environment=PYTHONUNBUFFERED=1
Environment=DEXTER3_TRANSPORT=openapi
Environment=DEXTER3_OPENAPI_DAEMON_URL=http://127.0.0.1:9877
Environment=DEXTER3_LIVE=1
Environment=DEXTER3_MODE=mscalp-brk
Environment=DEXTER3_FAST_TICK_SEC=8
Environment=DEXTER3_CAPITAL_USD=1000
Environment=DEXTER3_MAX_VOLUME_UNITS=10
Environment=DEXTER3_ACCOUNT_MAX_OPEN_RISK_USD=100000
Environment=DEXTER3_MIN_VOLUME_RISK_RATIO_CAP=0
Environment=DEXTER3_MIN_VOLUME_RISK_ABS_CAP_USD=0
Environment=DEXTER3_MIN_VOLUME_RISK_ABS_CAP_MULT=1.6
# --- trial tier (un-gated per owner order 2026-08-06; identical to the twins)
Environment=DEXTER3_DAILY_TARGET_USD=100000
Environment=DEXTER3_DAILY_LOSS_USD=100000
Environment=DEXTER3_BASE_RISK_FRAC=0.03
Environment=DEXTER3_MAX_RISK_FRAC=0.06
Environment=DEXTER3_MAX_ENTRIES_PER_DAY=999
Environment=DEXTER3_DAILY_LOSS_BASKETS=999
# --- producer owns the stop; generic SL floor OFF ---------------------------
Environment=DEXTER3_SL_FLOOR_TR_MULT=0
# --- producer knobs IDENTICAL to dexter3-mscalp (same raw signals) ----------
Environment=DEXTER3_MSCALP_ATR_LEN=14
Environment=DEXTER3_MSCALP_IMPULSE_BODY_FRAC=0.6
Environment=DEXTER3_MSCALP_RANGE_ATR=1.0
Environment=DEXTER3_MSCALP_DRIFT_BARS=72
Environment=DEXTER3_MSCALP_DRIFT_MIN_ATR=3.0
Environment=DEXTER3_MSCALP_SL_ATR=1.3
Environment=DEXTER3_MSCALP_TP_BACKSTOP_R=3.0
# --- THE lane's one addition: the blue-sky M15 gate (measured cell) ----------
Environment=DEXTER3_MSCALP_BRK_LOOK_M5=288
Environment=DEXTER3_MSCALP_BRK_PIVOT_K=2
# --- exits IDENTICAL to dexter3-mscalp (T15: bank 0.5R / 15-min / SL) --------
Environment=DEXTER3_OM_TRAIL_MODE=bank
Environment=DEXTER3_OM_BANK_R=0.5
Environment=DEXTER3_BASKET_TIME_STOP_MIN=15
Environment=DEXTER3_V16_HOUSE_MONEY_ENABLED=0
Environment=DEXTER3_ENTRY_CONFIRM=off
# --- lane hygiene (identical to the un-gated twins) --------------------------
Environment=DEXTER3_VP_DAYOPEN_BIAS=0
Environment=DEXTER3_VP_NO_TRADE_UTC=
Environment=DEXTER3_MAX_SPREAD_BPS=10000
Environment=DEXTER3_V16_ENTRY_QUALITY_ENABLED=0
Environment=DEXTER3_DAYREVERSAL=0
Environment=DEXTER3_SDZONE=0
Environment=DEXTER3_SMART_EXIT_ENABLED=0
Environment=DEXTER3_REPAIR_HARVEST=off
Environment=DEXTER3_PA_EYE=off
Environment=DEXTER3_WEEKEND_FLATTEN_ENABLED=1
Environment=DEXTER3_MARKET_STATE_GATE=1
Environment=DEXTER3_CROSS_LANE_DEDUP=downsize
ExecStart=/opt/dexter_pro/.venv/bin/python -X utf8 -m dexter3.shadow_runner --symbols USTEC --loop --poll-sec 20 --live

[Install]
WantedBy=multi-user.target
