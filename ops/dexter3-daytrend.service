# Dexter3 DAYTREND lane — LIVE canary (owner order 2026-07-16 "สร้างเลย เทรดจริงเลย").
#
# With-the-day pullback continuation — the owner's own manual method
# mechanized (3 green sells riding the 2026-07-16 sell-only day): day-open
# bias >=1h + pullback >=0.8xATR off the day extreme + reversal-resume close
# -> market entry, SL beyond the pullback swing, TP at the day extreme.
#
# Evidence (scripts/dexter3_entry_position_replay.py --producer daytrend
# --no-overlap = one position at a time, market x plain-TP h48):
#   6k  derive -7.96 (PF 0.95) / validate +34.98 (PF 1.30)
#   10k derive +59.99 (PF 1.22) / validate +14.67 (PF 1.07)
#   14k derive +62.77 (PF 1.15) / validate +30.55 (PF 1.11)
# First producer in repo history that survives the crash month. Exit is
# PLAIN broker SL/TP + 240min basket time stop: DEXTER3_OM_TRAIL_MODE=plain
# (the ladder amputates this producer; convex flipped signs under
# no-overlap). NO limit/intent layer: the signal bar IS the reversal-
# confirm close (no-knife rule satisfied by construction).
#
# Isolation: DEXTER3_MODE=daytrend -> own label (dexter3:dtr:canary), state
# file, lock, log — fable/grok/vp never touch its positions.
[Unit]
Description=Dexter3 DAYTREND lane LIVE canary (with-the-day continuation)
After=network-online.target dexter3-openapi-daemon.service
Wants=dexter3-openapi-daemon.service

[Service]
Type=simple
WorkingDirectory=/opt/dexter_pro
MemoryMax=200M
Restart=always
RestartSec=15
Environment=PYTHONUNBUFFERED=1
Environment=DEXTER3_TRANSPORT=openapi
Environment=DEXTER3_OPENAPI_DAEMON_URL=http://127.0.0.1:9877
Environment=DEXTER3_LIVE=1
Environment=DEXTER3_MODE=daytrend
Environment=DEXTER3_FAST_TICK_SEC=8
Environment=DEXTER3_CAPITAL_USD=1000
Environment=DEXTER3_MAX_VOLUME_UNITS=10
Environment=DEXTER3_MIN_VOLUME_RISK_RATIO_CAP=0
Environment=DEXTER3_MIN_VOLUME_RISK_ABS_CAP_USD=12
# canary risk. 2026-07-24 GOVERNOR-CAP UNLOCK (owner "ปลดล็อคเลยเอากำไรคืนมา"):
# measured the live -12.51 gap vs the replay +31R validate winner — it is NOT
# a strategy-design flaw (tested let-winners-run exits AND deeper-pullback
# entries in replay, both LOSE vs the shipped knobs; the geometry is at its
# optimum). The strangler is the DAILY CAP truncating the edge's distribution:
# at base risk $4/trade, DAILY_LOSS_USD=8 stopped the whole day after ~2 losers
# and TARGET=15 locked-and-stopped the winning days early — a 35%-WR / PF1.30
# trend edge (losing streaks common, money made on the fat winning-day tail)
# cannot express inside a 2-trade box. Governor floating was NEGATIVE at every
# cut (it was NOT amputating winners — that hypothesis was measured false), so
# the fix is ROOM, not removing protection. ASYMMETRIC loosen (tilt to the
# hunter payoff — let winners run, keep downside bounded), isolated to dtr,
# reversible, forward-measured (replay can't model the per-day governor, so
# forward realized PnL is the arbiter; revert if dtr's forward cum worsens).
Environment=DEXTER3_DAILY_TARGET_USD=30
Environment=DEXTER3_DAILY_LOSS_USD=16
Environment=DEXTER3_BASE_RISK_FRAC=0.004
Environment=DEXTER3_MAX_RISK_FRAC=0.008
Environment=DEXTER3_MAX_ENTRIES_PER_DAY=20
Environment=DEXTER3_DAILY_LOSS_BASKETS=5
# exits: broker SL/TP only + 240min time stop (= the replay's h48)
Environment=DEXTER3_OM_TRAIL_MODE=plain
Environment=DEXTER3_BASKET_TIME_STOP_MIN=240
# producer knobs = the proven values (change only via a new replay pass)
Environment=DEXTER3_DAYTREND_PULL_ATR=0.8
Environment=DEXTER3_DAYTREND_SWING_BARS=6
Environment=DEXTER3_DAYTREND_BUFFER_ATR=0.1
Environment=DEXTER3_DAYTREND_MIN_HOURS=1
Environment=DEXTER3_DAYTREND_MAX_RISK_ATR=2.0
# ORDER-FLOW entry (2026-07-24, owner "เข้าที่ยอดได้ถ้า flow ได้เปรียบ, อย่ายึด
# lagging indicators"): only take the continuation when the RESUME BAR shows
# real aggression -- a trend bar (body>=0.5) closing toward the extreme
# (clv>=0.6) = buyers/sellers in control THROUGH the bar; skip weak/doji
# resumes right off a rejection (the pid655570325 top-buy). Reads bar anatomy
# (leading), gates FLOW not location -- a top entry with strong flow is TAKEN.
# 2-window replay (market x plain, cap12): PF 1.28->1.45-1.50, WR 35->39%,
# derive flipped positive in window B. Forward = the arbiter (higher WR/PF
# should also realize better live under the governor). Revert = set both to 0.
Environment=DEXTER3_DAYTREND_RESUME_BODY=0.5
Environment=DEXTER3_DAYTREND_RESUME_CLV=0.6
# 2026-07-16 owner orders (after day-1: two continuation sells died to the
# DZ rebound; "ไม่ต้องการ shadow เพราะโอกาสแบบนี้หายาก เปิดเลย"):
# the capitulation handoff — beyond 12xATR day range the continuation STOPS
# (G1) and the DZ/SZ structure-flip reversal hunt takes over, LIVE.
# Reversal is exempt from the day-open bias gate BY DESIGN (counter-bias at
# the extreme is the whole idea); no-trade window still applies.
Environment=DEXTER3_DAYTREND_RANGE_CAP_ATR=12
Environment=DEXTER3_DAYREVERSAL=1
Environment=DEXTER3_DAYREV_ARM_ATR=12
Environment=DEXTER3_DAYREV_NEAR_ATR=2.0
Environment=DEXTER3_DAYREV_RETRACE=0.5
Environment=DEXTER3_DAYREV_SWING_K=2
# 2026-07-17 owner order ("โอกาสหายาก เปิดเลย"): SD-zone re-entry producer
# (shared dexter3/sd_zones.py engine = the replay proof, x day-open bias via
# the vp_entry_gate below; ~1 signal/day, plain exits unchanged).
# 2026-07-17: sdzone producer MOVED to the dedicated scalp lane
# (dexter3-scalp.service, bank-green exits) — running it on both
# lanes would recreate the grok/fable twin-entry disease.
Environment=DEXTER3_SDZONE=0
Environment=DEXTER3_VP_DAYOPEN_BIAS=1
Environment=DEXTER3_VP_BIAS_ANCHOR_HOUR=0
Environment=DEXTER3_VP_BIAS_MIN_HOURS=1
# shared lane hygiene
Environment=DEXTER3_VP_NO_TRADE_UTC=20:45-22:15
Environment=DEXTER3_SMART_EXIT_ENABLED=0
Environment=DEXTER3_REPAIR_HARVEST=off
Environment=DEXTER3_PA_EYE=off
Environment=DEXTER3_WEEKEND_FLATTEN_ENABLED=1
Environment=DEXTER3_CROSS_LANE_DEDUP=downsize
ExecStart=/opt/dexter_pro/.venv/bin/python -X utf8 -m dexter3.shadow_runner --symbols XAUUSD --loop --poll-sec 20 --live

[Install]
WantedBy=multi-user.target
