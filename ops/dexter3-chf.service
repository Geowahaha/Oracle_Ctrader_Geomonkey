# Dexter3 CHANNELFADE lane — Edge A, the RANGE-phase edge-fade (owner
# 2026-07-16/17 "ตลาด sideway...เก็บ Sell/Buy ขอบ ch บนล่าง"; re-authored
# 2026-07-24 "สร้าง อย่าตัด" after an all-red chop day where fable SOLD the
# range lows / BOUGHT the range highs — the exact inverse of this edge).
#
# WHAT: fade the EDGES of a detected sideways channel back toward the vp POC
# (graft the only live-positive lane's mechanism — vp +23.58 since surgery).
# The one regime no live lane covers. Producer = dexter3/channelfade.py.
#
# WHY A FORWARD A/B (not a replay promotion): the replay harness UNDER-RATES
# range edges — vp itself is replay-marginal ("both+ <=ladder" at best) yet
# LIVE +23.58, and dpull's replay was green but live -17.40. So replay is NOT
# the gate here; this lane gathers the honest arbiter: FORWARD realized PnL as
# a small canary, exactly like dexter3-dpull-cs. Promote/kill on the forward
# numbers at N>=30 (standing freeze), never on the in-sample fit.
#
# EXIT = PLAIN (broker SL/TP + basket caps only). A fade has a FIXED target
# (the POC/mid) and must NOT ride past it — the replay confirmed convex/ladder
# measurably DESTROY channelfade, plain-tp is the winner. ENTRY = MARKET at the
# M5 reversal close (the reversal-close IS the confirm; no limit dip, no
# ENTRY_CONFIRM — the replay's market x plain-tp was the profitable posture).
#
# DAY-OPEN BIAS is OFF: channelfade is a mean-reversion RANGE strategy, it
# fades BOTH edges regardless of the day-open trend (a bias gate would veto
# half the box by construction). No-trade window is kept (XAU close/reopen).
#
# Isolation: DEXTER3_MODE=channelfade -> own label (dexter3:chf:canary), state
# file, lock, log. No other lane touches its positions. Same-signal overlap is
# softened by the standing CROSS_LANE_DEDUP=downsize.
#
# OFF BY DEFAULT — not installed until owner sign-off. ACTIVATION:
#   sudo cp ops/dexter3-chf.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now dexter3-chf
[Unit]
Description=Dexter3 CHANNELFADE lane LIVE canary (range-phase edge-fade toward vp POC, forward A/B)
After=network-online.target dexter3-openapi-daemon.service
Wants=dexter3-openapi-daemon.service

[Service]
Type=simple
WorkingDirectory=/opt/dexter_pro
MemoryMax=200M
Restart=always
RestartSec=15
Environment=PYTHONUNBUFFERED=1
Environment=DEXTER3_TRANSPORT=openapi
Environment=DEXTER3_OPENAPI_DAEMON_URL=http://127.0.0.1:9877
Environment=DEXTER3_LIVE=1
Environment=DEXTER3_MODE=channelfade
Environment=DEXTER3_FAST_TICK_SEC=8
Environment=DEXTER3_CAPITAL_USD=1000
Environment=DEXTER3_MAX_VOLUME_UNITS=10
Environment=DEXTER3_MIN_VOLUME_RISK_RATIO_CAP=0
Environment=DEXTER3_MIN_VOLUME_RISK_ABS_CAP_USD=9
# --- canary risk (same tier as the other new-lane canaries) ----------------
Environment=DEXTER3_DAILY_TARGET_USD=15
Environment=DEXTER3_DAILY_LOSS_USD=8
Environment=DEXTER3_BASE_RISK_FRAC=0.004
Environment=DEXTER3_MAX_RISK_FRAC=0.008
Environment=DEXTER3_MAX_ENTRIES_PER_DAY=20
Environment=DEXTER3_DAILY_LOSS_BASKETS=3
# --- producer knobs (dexter3/channelfade.py; auditable in one place) --------
Environment=DEXTER3_CHF_WINDOW=36
Environment=DEXTER3_CHF_MIN_H_ATR=1.5
Environment=DEXTER3_CHF_MAX_H_ATR=4.0
Environment=DEXTER3_CHF_MAX_EFF=0.35
Environment=DEXTER3_CHF_EDGE_FRAC=0.2
Environment=DEXTER3_CHF_MIN_TOUCHES=2
Environment=DEXTER3_CHF_SL_BUF_ATR=0.35
Environment=DEXTER3_CHF_MAX_RISK_ATR=2.0
Environment=DEXTER3_CHF_TP_FRAC=0.5
Environment=DEXTER3_CHF_MIN_RR=1.0
# --- graft the winner's DNA: fade toward the vp POC, not the geometric mid --
Environment=DEXTER3_CHF_POC_TARGET=1
# --- entry: MARKET at the reversal close (no limit dip, no confirm walk) ----
Environment=DEXTER3_ENTRY_CONFIRM=off
# --- exit: PLAIN (the replay-confirmed channelfade exit) --------------------
Environment=DEXTER3_OM_TRAIL_MODE=plain
Environment=DEXTER3_BASKET_TIME_STOP_MIN=130
# --- lane hygiene ----------------------------------------------------------
Environment=DEXTER3_VP_DAYOPEN_BIAS=0
Environment=DEXTER3_VP_NO_TRADE_UTC=20:45-22:15
Environment=DEXTER3_DAYREVERSAL=0
Environment=DEXTER3_SDZONE=0
Environment=DEXTER3_SMART_EXIT_ENABLED=0
Environment=DEXTER3_REPAIR_HARVEST=off
Environment=DEXTER3_PA_EYE=off
Environment=DEXTER3_WEEKEND_FLATTEN_ENABLED=1
Environment=DEXTER3_CROSS_LANE_DEDUP=downsize
ExecStart=/opt/dexter_pro/.venv/bin/python -X utf8 -m dexter3.shadow_runner --symbols XAUUSD --loop --poll-sec 20 --live

[Install]
WantedBy=multi-user.target
