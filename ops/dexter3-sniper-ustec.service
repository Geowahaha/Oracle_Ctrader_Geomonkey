# Dexter3 SNIPER lane — USTEC unit (owner directive 2026-07-30). Same
# producer + posture as ops/dexter3-sniper.service (read that header first);
# this file documents ONLY what differs for the index symbol.
#
# WHY THE RISK TIER DIFFERS (measured 2026-07-29 on demo 9922808):
# USTEC minVolume = 1 unit ~= $1 per index point at ~27,500, and an M5-scale
# sniper stop is ~15..50 points -> the FLOOR risk per trade is ~$15-50.
# The XAU canary tier (loss $8 / abs-cap $9x1.6) would refuse nearly every
# entry (min_volume_risk_exceeds_abs_cap) — the exact "volatility-selective
# filter deletes the wide-stop winners" self-contradiction the 2026-07-25
# audit flagged. So this unit sizes the tier to the symbol's floor:
#   BASE_RISK_FRAC 0.03 -> intended ~$30 ~= the actual floor risk, keeping
#   risk_overrun_mult ~1 BY DESIGN (the audit's overrun pathology on XAU is
#   intended << actual; matching them is the honest fix available here);
#   DAILY_LOSS 60 ~= 2 floor-risk losses, TARGET 120 (same 2:1 shape as
#   every other lane), abs-cap 45x1.6 = $72 so a 3xATR-guarded stop fits.
# DEMO account — the point is forward evidence at honest sizes, not safety
# theatre (feedback_demo_let_strategies_trade).
#
# SL floor MAX_ABS is 80 POINTS here (10 on XAU): the ceiling is an absolute
# price distance and USTEC's TR runs ~25-40 points — a 10-point ceiling would
# clamp the floor below 1 x TR and quietly disable the one proven edge.
#
# ISOLATION: DEXTER3_SNIPER_SUFFIX=ustec forks label family to
# "dexter3:sniper-ustec" (executor's hyphen rule = a DIFFERENT family, same
# mechanism separating dpull/dpull-cs) and suffixes state/lock/log — the two
# sniper processes share NOTHING: no label, no governor day, no state file.
#
# The 20:45-22:15Z no-trade window doubles as USTEC's daily maintenance
# break (~20:55-22:05Z) — kept identical to the XAU unit on purpose.
#
# OFF BY DEFAULT — not installed until deploy sign-off. ACTIVATION:
#   sudo cp ops/dexter3-sniper-ustec.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now dexter3-sniper-ustec
[Unit]
Description=Dexter3 SNIPER lane LIVE canary USTEC (SHADOWCODES S/D zones + ST2 wick rejection + QM sweep)
After=network-online.target dexter3-openapi-daemon.service
Wants=dexter3-openapi-daemon.service

[Service]
Type=simple
WorkingDirectory=/opt/dexter_pro
MemoryMax=200M
Restart=always
RestartSec=15
Environment=PYTHONUNBUFFERED=1
Environment=DEXTER3_TRANSPORT=openapi
Environment=DEXTER3_OPENAPI_DAEMON_URL=http://127.0.0.1:9877
Environment=DEXTER3_LIVE=1
Environment=DEXTER3_MODE=sniper
Environment=DEXTER3_SNIPER_SUFFIX=ustec
Environment=DEXTER3_FAST_TICK_SEC=8
Environment=DEXTER3_CAPITAL_USD=1000
Environment=DEXTER3_MAX_VOLUME_UNITS=10
Environment=DEXTER3_MIN_VOLUME_RISK_RATIO_CAP=0
Environment=DEXTER3_MIN_VOLUME_RISK_ABS_CAP_USD=45
Environment=DEXTER3_MIN_VOLUME_RISK_ABS_CAP_MULT=1.6
# --- risk tier sized to USTEC's 1-unit floor (see header math) --------------
Environment=DEXTER3_DAILY_TARGET_USD=120
Environment=DEXTER3_DAILY_LOSS_USD=60
Environment=DEXTER3_BASE_RISK_FRAC=0.03
Environment=DEXTER3_MAX_RISK_FRAC=0.06
Environment=DEXTER3_MAX_ENTRIES_PER_DAY=20
Environment=DEXTER3_DAILY_LOSS_BASKETS=3
# --- the audit-proven SL floor (MAX_ABS in POINTS; USTEC TR ~25-40) ---------
Environment=DEXTER3_SL_FLOOR_TR_MULT=1.3
Environment=DEXTER3_SL_FLOOR_MAX_ABS=80
# --- producer knobs (identical to the XAU unit — one strategy, two symbols) -
Environment=DEXTER3_SNIPER_ATR_LEN=14
Environment=DEXTER3_SNIPER_BASE_BODY_FRAC=0.3
Environment=DEXTER3_SNIPER_IMPULSE_BODY_FRAC=0.6
Environment=DEXTER3_SNIPER_ZONE_MAX_AGE=100
Environment=DEXTER3_SNIPER_ST2_RATIO=2.5
Environment=DEXTER3_SNIPER_WICK_DOM=2.0
Environment=DEXTER3_SNIPER_SWEEP_LOOKBACK=20
Environment=DEXTER3_SNIPER_SL_ATR_BUF=0.5
Environment=DEXTER3_SNIPER_TP_R=2.0
Environment=DEXTER3_SNIPER_MAX_RISK_ATR=3.0
Environment=DEXTER3_SNIPER_SCAN_WINDOW=300
# --- TP = next opposing zone, skip <1R targets (owner phase-3 order 2026-08-01).
# Replay: 6k BOTH segments + (+7.34/+8.78R PF 1.46) vs 2R-TP's -12.83/+25.35;
# 12k validate +22.80 PF 1.42 ~= 2R's +23.71 with June-era still negative —
# more regime-robust, equal upside. Forward N>=30 remains the arbiter.
Environment=DEXTER3_SNIPER_TP_MODE=zone-minrr1
# --- entry: MARKET at the signal close --------------------------------------
Environment=DEXTER3_ENTRY_CONFIRM=off
# --- exit: PLAIN (fixed 2R broker TP IS the strategy) ------------------------
Environment=DEXTER3_OM_TRAIL_MODE=plain
Environment=DEXTER3_BASKET_TIME_STOP_MIN=130
# --- lane hygiene ------------------------------------------------------------
Environment=DEXTER3_VP_DAYOPEN_BIAS=0
Environment=DEXTER3_VP_NO_TRADE_UTC=20:45-22:15
Environment=DEXTER3_DAYREVERSAL=0
Environment=DEXTER3_SDZONE=0
Environment=DEXTER3_SMART_EXIT_ENABLED=0
Environment=DEXTER3_REPAIR_HARVEST=off
Environment=DEXTER3_PA_EYE=off
Environment=DEXTER3_WEEKEND_FLATTEN_ENABLED=1
Environment=DEXTER3_MARKET_STATE_GATE=1
Environment=DEXTER3_CROSS_LANE_DEDUP=downsize
ExecStart=/opt/dexter_pro/.venv/bin/python -X utf8 -m dexter3.shadow_runner --symbols USTEC --loop --poll-sec 20 --live

[Install]
WantedBy=multi-user.target
