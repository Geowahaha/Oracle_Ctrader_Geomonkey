# Dexter3 MSCALP lane — USTEC 5-minute close-based scalper (owner order
# 2026-08-05: "สร้าง incredible winner trading ทุกๆ 5 นาที จบแท่ง เปิด/ปิดใน
# แท่ง หรือถือถ้ากำไรยังไป — เทรด USTEC ตัวเดียวก่อน — พิสูจน์บนกราฟจริง").
#
# BUILT ONLY FROM LIVE-PROVEN COMPONENTS (feedback_live_wins_only):
#   with-momentum continuation (dtr = the week's real winner; reversion is
#   the measured loser), bank-small-green-fast on CLOSED bars (grok 0.35R
#   streaks / scalp bank-green / fixed-TP=66.5% of live gross), regime gate
#   (only trade when the market HAS a direction).
#
# ENTRY: impulse M5 close (body>0.6xrange, range>1xATR14) in the direction
# of the 6h drift, |drift| >= 3xATR. MARKET at the close.
# EXITS (all existing machinery): OM bank mode banks at +0.5R on a CLOSED
# bar; 15-min time stop (3 bars) flats the undecided; broker SL 1.3xATR is
# the disaster wick stop. TP 3R = far backstop only. One position at a time.
#
# EVIDENCE (filter, NOT proof — the binding standard is live wins only):
# points-based check on real USTEC M5, 2026-07-21→08-05, spread 1.5 charged,
# one-position: derive +$177 (N=105) / validate +$368 (N=85), WR 53%,
# ~19 trades/day. Judged from here on BROKER DEALS ONLY.
#
# Risk tier = the ustec honest tier (risk/trade = 1.3xATR x $1/pt ~= $30-45
# at the 1-unit floor): LOSS 120 ~= 3 full losses, TARGET 240. SL floor env
# is OFF — the producer owns the stop; the floor would double-widen it.
#
# ACTIVATION:
#   sudo cp ops/dexter3-mscalp.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now dexter3-mscalp
[Unit]
Description=Dexter3 MSCALP lane LIVE canary USTEC (5-min impulse-continuation scalp, bank/time/SL exits)
After=network-online.target dexter3-openapi-daemon.service
Wants=dexter3-openapi-daemon.service

[Service]
Type=simple
WorkingDirectory=/opt/dexter_pro
MemoryMax=200M
Restart=always
RestartSec=15
Environment=PYTHONUNBUFFERED=1
Environment=DEXTER3_TRANSPORT=openapi
Environment=DEXTER3_OPENAPI_DAEMON_URL=http://127.0.0.1:9877
Environment=DEXTER3_LIVE=1
Environment=DEXTER3_MODE=mscalp
Environment=DEXTER3_FAST_TICK_SEC=8
Environment=DEXTER3_CAPITAL_USD=1000
Environment=DEXTER3_MAX_VOLUME_UNITS=10
Environment=DEXTER3_ACCOUNT_MAX_OPEN_RISK_USD=300
Environment=DEXTER3_MIN_VOLUME_RISK_RATIO_CAP=0
Environment=DEXTER3_MIN_VOLUME_RISK_ABS_CAP_USD=45
Environment=DEXTER3_MIN_VOLUME_RISK_ABS_CAP_MULT=1.6
# --- risk tier (ustec honest tier; risk/trade ~= $30-45 at the 1-unit floor)
Environment=DEXTER3_DAILY_TARGET_USD=240
Environment=DEXTER3_DAILY_LOSS_USD=120
Environment=DEXTER3_BASE_RISK_FRAC=0.03
Environment=DEXTER3_MAX_RISK_FRAC=0.06
Environment=DEXTER3_MAX_ENTRIES_PER_DAY=30
Environment=DEXTER3_DAILY_LOSS_BASKETS=5
# --- producer owns the stop; generic SL floor OFF (would double-widen) -----
Environment=DEXTER3_SL_FLOOR_TR_MULT=0
# --- producer knobs (the filter-passing cell; dexter3/mscalp.py) ------------
Environment=DEXTER3_MSCALP_ATR_LEN=14
Environment=DEXTER3_MSCALP_IMPULSE_BODY_FRAC=0.6
Environment=DEXTER3_MSCALP_RANGE_ATR=1.0
Environment=DEXTER3_MSCALP_DRIFT_BARS=72
Environment=DEXTER3_MSCALP_DRIFT_MIN_ATR=3.0
Environment=DEXTER3_MSCALP_SL_ATR=1.3
Environment=DEXTER3_MSCALP_TP_BACKSTOP_R=3.0
# --- exits: bank on closed bars + time stop; house-money OFF ----------------
Environment=DEXTER3_OM_TRAIL_MODE=bank
Environment=DEXTER3_OM_BANK_R=0.5
Environment=DEXTER3_BASKET_TIME_STOP_MIN=15
Environment=DEXTER3_V16_HOUSE_MONEY_ENABLED=0
Environment=DEXTER3_ENTRY_CONFIRM=off
# --- lane hygiene ------------------------------------------------------------
Environment=DEXTER3_VP_DAYOPEN_BIAS=0
Environment=DEXTER3_VP_NO_TRADE_UTC=20:45-22:15
Environment=DEXTER3_DAYREVERSAL=0
Environment=DEXTER3_SDZONE=0
Environment=DEXTER3_SMART_EXIT_ENABLED=0
Environment=DEXTER3_REPAIR_HARVEST=off
Environment=DEXTER3_PA_EYE=off
Environment=DEXTER3_WEEKEND_FLATTEN_ENABLED=1
Environment=DEXTER3_MARKET_STATE_GATE=1
Environment=DEXTER3_CROSS_LANE_DEDUP=downsize
ExecStart=/opt/dexter_pro/.venv/bin/python -X utf8 -m dexter3.shadow_runner --symbols USTEC --loop --poll-sec 20 --live

[Install]
WantedBy=multi-user.target
