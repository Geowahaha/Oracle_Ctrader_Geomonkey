# Dexter3 MSCALP-BE-BASE lane — the BEW exit on the ORIGINAL entry (owner
# order 2026-08-07: "กลับไป mscalp-be entry เดิม exit BEW อีกรอบ ... run
# parallel กับ mscalp-be BRK BEW ด้วย").
#
# WHY: the USTEC matrix had BASE×{T15, $5-take} and BRK×{T15, BEW} but no
# BASE×BEW cell, so the BEW exit's own contribution could not be separated
# from the BRK entry it happened to be paired with. This unit fills that
# cell. Read the grid:
#     mscalp          BASE + T15      (entry control, exit control)
#     mscalp2         BASE + $5-take  (exit effect on BASE)
#     THIS UNIT       BASE + BEW      (exit effect on BASE)   <-- new
#     mscalp-brk      BRK  + T15      (entry effect on T15)
#     mscalp-be       BRK  + BEW      (both effects together)
# mscalp-be MINUS this unit = the entry effect measured on the BEW exit;
# this unit MINUS mscalp = the BEW effect measured on the original entry.
#
# WHAT: identical producer, knobs, tier and BEW exit to dexter3-mscalp-be.
# The ONLY differences are (1) NO DEXTER3_MSCALP_ENTRY -> the original
# decide_mscalp entries, and (2) DEXTER3_MSCALP_BE_SUFFIX=base, which forks
# the label family / state / lock / log the same way DEXTER3_SNIPER_SUFFIX
# forks the sniper pair. dexter3-mscalp-be is NOT touched or restarted by
# this deploy — its BRK+BEW trial keeps its N.
#
# EXIT (BEW, corrected semantics from the 2026-08-06 live broker rejection):
# at 900s a position at/above breakeven has its SL amended to entry and
# rides on (bank 0.5R / TP 3R / BE); an UNDERWATER position is closed at
# market (reason be_time) because an entry-level stop on the losing side is
# rejected by the broker and would fill at market anyway.
#
# JUDGE: N>=30 broker deals in DOLLARS vs mscalp (same entry, T15 exit) and
# vs mscalp-be (same exit, BRK entry). No tuning mid-trial. Trial tier
# un-gated per the standing 2026-08-06 order — restore caps before any
# real-money promotion.
#
# ACTIVATION (start ONLY this unit):
#   sudo cp ops/dexter3-mscalp-be-base.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now dexter3-mscalp-be-base
[Unit]
Description=Dexter3 MSCALP-BE-BASE lane LIVE canary USTEC (original entries + BEW exit, parallel to the BRK+BEW twin)
After=network-online.target dexter3-openapi-daemon.service
Wants=dexter3-openapi-daemon.service

[Service]
Type=simple
WorkingDirectory=/opt/dexter_pro
MemoryMax=200M
Restart=always
RestartSec=15
Environment=PYTHONUNBUFFERED=1
Environment=DEXTER3_TRANSPORT=openapi
Environment=DEXTER3_OPENAPI_DAEMON_URL=http://127.0.0.1:9877
Environment=DEXTER3_LIVE=1
Environment=DEXTER3_MODE=mscalp-be
# --- THE fork: own label family / state / lock / log (sniper-pair pattern) ---
Environment=DEXTER3_MSCALP_BE_SUFFIX=base
Environment=DEXTER3_FAST_TICK_SEC=8
Environment=DEXTER3_CAPITAL_USD=1000
Environment=DEXTER3_MAX_VOLUME_UNITS=10
Environment=DEXTER3_ACCOUNT_MAX_OPEN_RISK_USD=100000
Environment=DEXTER3_MIN_VOLUME_RISK_RATIO_CAP=0
Environment=DEXTER3_MIN_VOLUME_RISK_ABS_CAP_USD=0
Environment=DEXTER3_MIN_VOLUME_RISK_ABS_CAP_MULT=1.6
# --- risk tier IDENTICAL to the rest of the USTEC matrix --------------------
Environment=DEXTER3_DAILY_TARGET_USD=100000
Environment=DEXTER3_DAILY_LOSS_USD=100000
Environment=DEXTER3_BASE_RISK_FRAC=0.03
Environment=DEXTER3_MAX_RISK_FRAC=0.06
Environment=DEXTER3_MAX_ENTRIES_PER_DAY=999
Environment=DEXTER3_DAILY_LOSS_BASKETS=999
# --- producer owns the stop; generic SL floor OFF ---------------------------
Environment=DEXTER3_SL_FLOOR_TR_MULT=0
# --- producer knobs IDENTICAL to dexter3-mscalp (same raw signals) ----------
Environment=DEXTER3_MSCALP_ATR_LEN=14
Environment=DEXTER3_MSCALP_IMPULSE_BODY_FRAC=0.6
Environment=DEXTER3_MSCALP_RANGE_ATR=1.0
Environment=DEXTER3_MSCALP_DRIFT_BARS=72
Environment=DEXTER3_MSCALP_DRIFT_MIN_ATR=3.0
Environment=DEXTER3_MSCALP_SL_ATR=1.3
Environment=DEXTER3_MSCALP_TP_BACKSTOP_R=3.0
# --- NO DEXTER3_MSCALP_ENTRY here: this lane runs the ORIGINAL entries ------
# --- exit: BEW at 15 min (240m basket cap = fail-safe only, never 0) --------
Environment=DEXTER3_MSCALP_BE_SEC=900
Environment=DEXTER3_OM_TRAIL_MODE=bank
Environment=DEXTER3_OM_BANK_R=0.5
Environment=DEXTER3_BASKET_TIME_STOP_MIN=240
Environment=DEXTER3_V16_HOUSE_MONEY_ENABLED=0
Environment=DEXTER3_ENTRY_CONFIRM=off
# --- lane hygiene (identical to the rest of the matrix) ----------------------
Environment=DEXTER3_VP_DAYOPEN_BIAS=0
Environment=DEXTER3_VP_NO_TRADE_UTC=
Environment=DEXTER3_MAX_SPREAD_BPS=10000
Environment=DEXTER3_V16_ENTRY_QUALITY_ENABLED=0
Environment=DEXTER3_DAYREVERSAL=0
Environment=DEXTER3_SDZONE=0
Environment=DEXTER3_SMART_EXIT_ENABLED=0
Environment=DEXTER3_REPAIR_HARVEST=off
Environment=DEXTER3_PA_EYE=off
Environment=DEXTER3_WEEKEND_FLATTEN_ENABLED=1
Environment=DEXTER3_MARKET_STATE_GATE=1
Environment=DEXTER3_CROSS_LANE_DEDUP=downsize
ExecStart=/opt/dexter_pro/.venv/bin/python -X utf8 -m dexter3.shadow_runner --symbols USTEC --loop --poll-sec 20 --live

[Install]
WantedBy=multi-user.target
