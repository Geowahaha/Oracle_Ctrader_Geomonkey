# Dexter3 MSCALP2 lane — the mscalp dollar-take twin (owner order 2026-08-06:
# "clone ทำ parallel lane ของ Mscalp แต่ให้เก็บ real scalp แบบกำไร >5/10 USD
# ให้ปิดเลย และใช้ exit แบบเดียวกับต้นแบบ").
#
# WHAT: byte-identical to dexter3-mscalp (same producer, same entries, same
# bank 0.5R / 15-min / SL 1.3xATR exits) with EXACTLY ONE addition — the
# fast-tick dollar-take: close the first tick the REAL broker floating PnL
# reaches DEXTER3_MSCALP2_TAKE_USD. A forward A/B on the same signals
# (the dpull vs dpull-cs pattern) measuring take-fast vs bank-the-tail.
#
# WHY $5 (filter, NOT proof — day-1 mscalp autopsy 2026-08-06, N=12 real
# positions replayed against M1 MFE): $5-take ~= +$29.7 (11W/1L) vs actual
# +$50.90; $10-take ~= -$2.7 — it caps the +101.4 tail AND misses the three
# losers whose MFE peaked $6.7-9.5. $5 is the data-favored of the two owner
# thresholds. JUDGE: N>=30 broker deals in DOLLARS vs the mscalp original,
# no tuning mid-trial.
#
# ACTIVATION (start ONLY this unit):
#   sudo cp ops/dexter3-mscalp2.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now dexter3-mscalp2
[Unit]
Description=Dexter3 MSCALP2 lane LIVE canary USTEC (mscalp twin + $5 dollar-take, forward A/B)
After=network-online.target dexter3-openapi-daemon.service
Wants=dexter3-openapi-daemon.service

[Service]
Type=simple
WorkingDirectory=/opt/dexter_pro
MemoryMax=200M
Restart=always
RestartSec=15
Environment=PYTHONUNBUFFERED=1
Environment=DEXTER3_TRANSPORT=openapi
Environment=DEXTER3_OPENAPI_DAEMON_URL=http://127.0.0.1:9877
Environment=DEXTER3_LIVE=1
Environment=DEXTER3_MODE=mscalp2
Environment=DEXTER3_FAST_TICK_SEC=8
Environment=DEXTER3_CAPITAL_USD=1000
Environment=DEXTER3_MAX_VOLUME_UNITS=10
Environment=DEXTER3_ACCOUNT_MAX_OPEN_RISK_USD=100000
Environment=DEXTER3_MIN_VOLUME_RISK_RATIO_CAP=0
Environment=DEXTER3_MIN_VOLUME_RISK_ABS_CAP_USD=0
Environment=DEXTER3_MIN_VOLUME_RISK_ABS_CAP_MULT=1.6
# --- risk tier IDENTICAL to dexter3-mscalp (clean A/B) -----------------------
Environment=DEXTER3_DAILY_TARGET_USD=100000
Environment=DEXTER3_DAILY_LOSS_USD=100000
Environment=DEXTER3_BASE_RISK_FRAC=0.03
Environment=DEXTER3_MAX_RISK_FRAC=0.06
Environment=DEXTER3_MAX_ENTRIES_PER_DAY=999
Environment=DEXTER3_DAILY_LOSS_BASKETS=999
# --- producer owns the stop; generic SL floor OFF (would double-widen) -------
Environment=DEXTER3_SL_FLOOR_TR_MULT=0
# --- producer knobs IDENTICAL to dexter3-mscalp (same signals by construction)
Environment=DEXTER3_MSCALP_ATR_LEN=14
Environment=DEXTER3_MSCALP_IMPULSE_BODY_FRAC=0.6
Environment=DEXTER3_MSCALP_RANGE_ATR=1.0
Environment=DEXTER3_MSCALP_DRIFT_BARS=72
Environment=DEXTER3_MSCALP_DRIFT_MIN_ATR=3.0
Environment=DEXTER3_MSCALP_SL_ATR=1.3
Environment=DEXTER3_MSCALP_TP_BACKSTOP_R=3.0
# --- exits: ORIGINAL mscalp exits + THE ONE ADDITION (the $5 dollar-take) ----
Environment=DEXTER3_MSCALP2_TAKE_USD=5
Environment=DEXTER3_OM_TRAIL_MODE=bank
Environment=DEXTER3_OM_BANK_R=0.5
Environment=DEXTER3_BASKET_TIME_STOP_MIN=15
Environment=DEXTER3_V16_HOUSE_MONEY_ENABLED=0
Environment=DEXTER3_ENTRY_CONFIRM=off
# --- lane hygiene (identical to dexter3-mscalp) ------------------------------
Environment=DEXTER3_VP_DAYOPEN_BIAS=0
Environment=DEXTER3_VP_NO_TRADE_UTC=
Environment=DEXTER3_MAX_SPREAD_BPS=10000
Environment=DEXTER3_V16_ENTRY_QUALITY_ENABLED=0
Environment=DEXTER3_DAYREVERSAL=0
Environment=DEXTER3_SDZONE=0
Environment=DEXTER3_SMART_EXIT_ENABLED=0
Environment=DEXTER3_REPAIR_HARVEST=off
Environment=DEXTER3_PA_EYE=off
Environment=DEXTER3_WEEKEND_FLATTEN_ENABLED=1
Environment=DEXTER3_MARKET_STATE_GATE=1
Environment=DEXTER3_CROSS_LANE_DEDUP=downsize
ExecStart=/opt/dexter_pro/.venv/bin/python -X utf8 -m dexter3.shadow_runner --symbols USTEC --loop --poll-sec 20 --live

[Install]
WantedBy=multi-user.target
