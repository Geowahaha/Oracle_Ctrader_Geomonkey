# Dexter3 Fable V1.8 size-the-edge — LIVE lane on the VM (OpenAPI daemon transport, demo 9922808).
# The cutover target: this replaces the PC-hosted lane so the PC can power off.
# SAFETY: never run this live at the same time as the PC-hosted lane or the
# paper unit on the same label — one host per label at a time (double-trade
# risk). Governor loss-stop preserved from PC.
# 2026-07-10 cutover fix: DEXTER3_MAX_VOLUME_UNITS=10 was DROPPED from the PC
# launcher during unit creation -> fell back to the 0.05 BTC-scale default ->
# every XAU entry refused (min_volume_exceeds_max_volume_units_cap; XAU
# minVolume=1 oz). Restored to PC value 10. Ratio cap loosened to 0 (off) per
# owner directive so the de-sized micro setups also fire; per-trade risk stays
# bounded by the governor cap (capital x 2.5% = $25). Revert cap to 1.5 for
# PC-parity (skip low-conviction micro trades) if they underperform.
[Unit]
Description=Dexter3 Fable V1.8 size-the-edge LIVE lane (OpenAPI daemon)
After=network-online.target dexter3-openapi-daemon.service
Wants=dexter3-openapi-daemon.service

[Service]
Type=simple
WorkingDirectory=/opt/dexter_pro
MemoryMax=200M
Restart=always
RestartSec=15
Environment=PYTHONUNBUFFERED=1
Environment=DEXTER3_TRANSPORT=openapi
Environment=DEXTER3_OPENAPI_DAEMON_URL=http://127.0.0.1:9877
Environment=DEXTER3_LIVE=1
Environment=DEXTER3_HUNT=1
Environment=DEXTER3_FAST_TICK_SEC=8
Environment=DEXTER3_CAPITAL_USD=1000
Environment=DEXTER3_MAX_VOLUME_UNITS=10
Environment=DEXTER3_MIN_VOLUME_RISK_RATIO_CAP=0
# 2026-07-10 negative-skew plug: floored 1oz trades pay tight-stop risk only
# (disaster widening reverted at the floor — code default ON) + hard $ ceiling
Environment=DEXTER3_MIN_VOLUME_RISK_ABS_CAP_USD=12
Environment=DEXTER3_FABLE_VERSION=v1.8-size-the-edge
# v16 mode is default
# 2026-07-17 owner: fable day was 'ผิดปกติอย่างมาก' — anatomy: ONE trade
# (654047528) lost -23.80 = 47% of the -50.20 day because V18 WINNER-BOOST
# multiplied size x1.6 to the $25 governor cap on an 'elite_score' A+ buy
# at the London top. The 10k conviction study proved leader_score has NO
# predictive content; ledger day-1 showed the score gate blocking +6.94R of
# winners; day-2 the boost sized the day's worst trade. Sizing levers keyed
# to measured noise are OFF. B_TIER stays ON for its scheduled 07-22
# verdict (separate mechanism, judged on its own numbers).
Environment=DEXTER3_V18_WINNER_BOOST_ENABLED=0
Environment=DEXTER3_V18_CHASE_RESCUE_ENABLED=0
Environment=DEXTER3_V18_B_TIER_ENABLED=1
Environment=DEXTER3_DAILY_TARGET_USD=100
Environment=DEXTER3_DAILY_LOSS_USD=50
Environment=DEXTER3_BASE_RISK_FRAC=0.0175
# --- PC-launcher parity (proven config). These lived ONLY in VM drop-ins
# after cutover; consolidated here 2026-07-16 as the single source of truth
# after DEXTER3_SMART_EXIT_ENABLED=0 was found MISSING on the VM (defaulted
# ON) and closed positions ~28s after entry via smart_confirmed_break —
# missing opportunity AND preempting the basket repair-leg / harvest (a
# close_all fired before any position could stay trapped). PC ran smart-exit
# OFF. Redeploying this unit now carries the whole proven env; do not rely on
# untracked drop-ins.
Environment=DEXTER3_SMART_EXIT_ENABLED=0
Environment=DEXTER3_MAX_ENTRIES_PER_DAY=60
Environment=DEXTER3_DAILY_LOSS_BASKETS=3
# 2026-07-16 owner: "exit มีปัญหา OM ทำงานไม่ดี ปิดกำไรเร็วไป" — re-measured
# at the CURRENT entry stack (bias-skip + limit + confirm; 3 windows,
# no-overlap): the ladder is now the WORST exit (-141.8R total) vs plain
# structural TP (-35.5R; better in EVERY window, +16/+26/+44R). Flip to
# plain: broker SL/TP + 240min time stop + caps are the exits; the ladder
# CSV stays for rollback. NAMED TRADEOFF: trail-mode lanes defer the M5
# campaign brain -> repair legs / harvest-shadow episodes pause on fable.
Environment=DEXTER3_OM_TRAIL_MODE=plain
Environment=DEXTER3_BASKET_TIME_STOP_MIN=240
Environment=DEXTER3_OM_LADDER_CSV=0.25:0.02,0.50:0.15,0.80:0.40,1.20:0.80,2.00:1.45,3.00:2.25
Environment=DEXTER3_ANTICHASE_ENABLED=1
Environment=DEXTER3_PULLBACK_ENABLED=1
Environment=DEXTER3_V16_PROFIT_CONTROLS_ENABLED=1
Environment=DEXTER3_V16_COOLDOWN_ENABLED=0
Environment=DEXTER3_V16_GREEN_THRESHOLD_USD=20
Environment=DEXTER3_V16_HOUSE_THRESHOLD_USD=30
Environment=DEXTER3_V16_HOUSE_FLOOR_USD=20
Environment=DEXTER3_V16_WEAK_MULT=0.25
Environment=DEXTER3_V16_WINNER_MULT=2.0
Environment=DEXTER3_V16_HOUSE_MULT=3.0
Environment=DEXTER3_V16_MAX_EDGE_MULT=3.0
# VM-intentional (post-cutover): shadow observers + weekend safety
Environment=DEXTER3_PA_EYE=shadow
Environment=DEXTER3_WEEKEND_FLATTEN_ENABLED=1
Environment=DEXTER3_REPAIR_HARVEST=shadow
Environment=DEXTER3_REPAIR_HARVEST_BANK_TARGET_R=0.4
Environment=DEXTER3_REPAIR_HARVEST_SCALP_SL_FRAC=0.5
# 2026-07-16: harvest shadow starved (0 episodes / 5 trapped baskets) because
# the classic repair-leg makes the basket multi-leg BEFORE agg_r hits -1.2R,
# and episode-open required exactly one leg. Observe-only unblock; hard-blocked
# in live mode by two independent guards.
Environment=DEXTER3_REPAIR_HARVEST_MULTILEG_OBSERVE=1
# 2026-07-16 twin-entry plug: both lanes run the SAME producer (decide_hunt) on
# the same bars -> near-simultaneous same-side entries doubled risk with zero
# diversification (3 pairs = ~-34.8 of the -34.00 overnight net). DOWNSIZE (not
# skip) per the owner's standing rule: never add hard blockers on demo — the
# follower still trades (keeps both lanes' A/B sample intact for the 07-22
# verdicts), at half risk. Escalate to "skip" only if downsize proves too weak.
Environment=DEXTER3_CROSS_LANE_DEDUP=downsize
# 2026-07-16 owner orders ("เอาสิ่งที่เราเจอวันนี้ไปปรับปรุง" + option A
# "ไม่รับมีด"): day-open bias SKIP (counter-bias entries BLOCKED outright —
# owner explicitly overrode the old no-hard-blockers rule after the 12:06Z
# knife-catch buy on a ต่ำเปิด day), trough-limit entry at signal-0.4R that
# fills ONLY on an M1 reversal-confirm (a close beyond the structural SL
# kills the setup, no trade), and the daily close/reopen entry pause.
# Replay economics on the hunt producer: bleed -$62..74/day -> -$27..30/day.
# HONEST LIMIT: these reduce loss, they do NOT make hunt profitable — no
# hunt config ever passed both segments; VP lane is the edge candidate.
Environment=DEXTER3_HUNT_DAYOPEN_BIAS=skip
Environment=DEXTER3_HUNT_BIAS_ANCHOR_HOUR=0
Environment=DEXTER3_HUNT_BIAS_MIN_HOURS=1
Environment=DEXTER3_HUNT_BIAS_DOWNSIZE_MULT=0.25
Environment=DEXTER3_HUNT_LIMIT_DIP_R=0.4
Environment=DEXTER3_HUNT_LIMIT_TTL_MIN=30
# owner 2026-07-16: reversal-confirm entries ONLY (no knife catching)
Environment=DEXTER3_ENTRY_CONFIRM=m1
Environment=DEXTER3_HUNT_NO_TRADE_UTC=20:45-22:15
ExecStart=/opt/dexter_pro/.venv/bin/python -X utf8 -m dexter3.shadow_runner --symbols XAUUSD --loop --poll-sec 20 --live

[Install]
WantedBy=multi-user.target
