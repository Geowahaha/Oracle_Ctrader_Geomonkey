# Dexter3 Fable V1.8 lane on the VM (OpenAPI transport) — P3 cutover unit.
# Install: sudo cp ops/dexter3-fable.service /etc/systemd/system/ && sudo systemctl daemon-reload
# DO NOT enable until the P3 cutover checklist in docs/DEXTER3_VM_MIGRATION_DESIGN.md is green
# (token installed + persistent daemon serving reads + shadow session passed + PC lanes stopped).
[Unit]
Description=Dexter3 Fable V1.8 lane (XAUUSD, OpenAPI transport)
After=network-online.target ctrader-token-keepalive.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/dexter_pro
# Env mirrors ops/dexter3_xau_v16_loop.ps1 (the PC launcher) — keep in sync.
Environment=PYTHONUNBUFFERED=1
Environment=DEXTER3_TRANSPORT=openapi
Environment=DEXTER3_LIVE=1
Environment=DEXTER3_HUNT=1
Environment=DEXTER3_FABLE_VERSION=v1.8-size-the-edge
Environment=DEXTER3_FAST_TICK_SEC=8
Environment=DEXTER3_MAX_VOLUME_UNITS=10
Environment=DEXTER3_MAX_ENTRIES_PER_DAY=60
Environment=DEXTER3_DAILY_LOSS_BASKETS=3
Environment=DEXTER3_ANTICHASE_ENABLED=1
Environment=DEXTER3_PULLBACK_ENABLED=1
Environment=DEXTER3_SMART_EXIT_ENABLED=0
Environment=DEXTER3_CAPITAL_USD=1000
Environment=DEXTER3_DAILY_TARGET_USD=100
Environment=DEXTER3_DAILY_LOSS_USD=50
Environment=DEXTER3_BASE_RISK_FRAC=0.0175
Environment=DEXTER3_V16_PROFIT_CONTROLS_ENABLED=1
Environment=DEXTER3_V16_COOLDOWN_ENABLED=0
Environment=DEXTER3_V18_WINNER_BOOST_ENABLED=1
Environment=DEXTER3_V18_CHASE_RESCUE_ENABLED=1
Environment=DEXTER3_V18_B_TIER_ENABLED=1
Environment=DEXTER3_MIN_VOLUME_RISK_RATIO_CAP=1.5
ExecStart=/opt/dexter_pro/.venv/bin/python -X utf8 -m dexter3.shadow_runner --symbols XAUUSD --loop --poll-sec 20 --live
Restart=always
RestartSec=20
# 1GB box shared with the main system — a leaking lane must die before the box does.
MemoryMax=200M

[Install]
WantedBy=multi-user.target
