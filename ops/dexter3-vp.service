# Dexter3 VOLUME-PROFILE canary lane — DO NOT ENABLE WITHOUT OWNER SIGN-OFF.
#
# Evidence (2026-07-11, AGENT_SYNC_BOARD 22:15Z/22:45Z entries): the VP
# producer is the FIRST candidate to pass the promotion gate on BOTH hold-out
# splits — 60/40: validate +76.4R PF 1.57 (~$85/day at $12/R); 50/50:
# validate +67.2R PF 1.36 (~$54/day). ~20 setups/day, month window.
#
# Isolation: DEXTER3_MODE=vp gives this lane its own broker label
# (dexter3:vp:canary), state file (dexter3_vp_shadow_state.json) and lock —
# same pattern as the grok lane; fable/grok never touch VP positions.
#
# SCOUT SIZE by design: governor 15/8 (half grok's 30/15), base risk 0.4%,
# ratio caps inherited via .env.local. Scaling only after >=100 forward
# trades + PF>1.2 per the standing freeze.
#
# EXIT POSTURE NOTE: the replay favored PLAIN exits + hold 48 bars (VP TPs
# are structural and need time). The live OM ladder may cut VP winners early
# — measure the first forward week BEFORE changing OM knobs; if forward PF
# lags the replay badly, try DEXTER3_OM_LADDER_CSV with looser early rungs
# for THIS unit only.
#
# ACTIVATION (after owner sign-off):
#   sudo cp ops/dexter3-vp.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now dexter3-vp
[Unit]
Description=Dexter3 Volume-Profile canary lane (OpenAPI daemon, scout size)
After=network-online.target dexter3-openapi-daemon.service
Wants=dexter3-openapi-daemon.service

[Service]
Type=simple
WorkingDirectory=/opt/dexter_pro
MemoryMax=200M
Restart=always
RestartSec=15
Environment=PYTHONUNBUFFERED=1
Environment=DEXTER3_TRANSPORT=openapi
Environment=DEXTER3_OPENAPI_DAEMON_URL=http://127.0.0.1:9877
Environment=DEXTER3_LIVE=1
Environment=DEXTER3_MODE=vp
Environment=DEXTER3_FAST_TICK_SEC=8
Environment=DEXTER3_CAPITAL_USD=1000
Environment=DEXTER3_MAX_VOLUME_UNITS=10
Environment=DEXTER3_MIN_VOLUME_RISK_RATIO_CAP=0
Environment=DEXTER3_MIN_VOLUME_RISK_ABS_CAP_USD=9
Environment=DEXTER3_DAILY_TARGET_USD=15
Environment=DEXTER3_DAILY_LOSS_USD=8
Environment=DEXTER3_BASE_RISK_FRAC=0.004
Environment=DEXTER3_MAX_RISK_FRAC=0.008
ExecStart=/opt/dexter_pro/.venv/bin/python -X utf8 -m dexter3.shadow_runner --symbols XAUUSD --loop --poll-sec 20 --live

[Install]
WantedBy=multi-user.target
