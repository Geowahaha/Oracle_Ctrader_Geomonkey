# Dexter3 VOLUME-PROFILE canary lane — OWNER SIGN-OFF GIVEN 2026-07-16
# ("ไม่ต้องทำ shadow แล้ว deploy เลย"), shadow phase explicitly waived.
#
# Deployed variant = the 3-window replay survivor with the largest sample
# (scripts/dexter3_entry_position_replay.py; VM /tmp/entry_pos_vp_{6k,10k,20k}.log,
# all six segment-cells positive):
#   VP producer x day-open bias (00Z anchor, >=1h; ต่ำเปิด -> sells only,
#   ยืนเปิด -> buys only) x synthetic LIMIT at entry-0.4R (SL structural,
#   TTL 30min, fill-vs-level delta journaled) x CONVEX trail exit (arm 1.0R,
#   giveback 3.0xATR, max age 240min; DEXTER3_OM_TRAIL_MODE=convex replaces
#   hard-take/ladder/stall/pyramid for THIS lane only) + no-trade window
#   around the daily close/reopen (owner 2026-07-16).
#
# Isolation: DEXTER3_MODE=vp gives this lane its own broker label
# (dexter3:vp:*), state file (dexter3_vp_shadow_state.json) and lock —
# same pattern as the grok lane; fable/grok never touch VP positions.
#
# SCOUT SIZE by design: governor 15/8, base risk 0.4%. Scaling only after
# >=100 forward trades + PF>1.2 per the standing freeze.
#
# ACTIVATION:
#   sudo cp ops/dexter3-vp.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now dexter3-vp
[Unit]
Description=Dexter3 VP lane LIVE canary (day-open bias x limit x convex)
After=network-online.target dexter3-openapi-daemon.service
Wants=dexter3-openapi-daemon.service

[Service]
Type=simple
WorkingDirectory=/opt/dexter_pro
MemoryMax=200M
Restart=always
RestartSec=15
Environment=PYTHONUNBUFFERED=1
Environment=DEXTER3_TRANSPORT=openapi
Environment=DEXTER3_OPENAPI_DAEMON_URL=http://127.0.0.1:9877
Environment=DEXTER3_LIVE=1
Environment=DEXTER3_MODE=vp
Environment=DEXTER3_FAST_TICK_SEC=8
Environment=DEXTER3_CAPITAL_USD=1000
Environment=DEXTER3_MAX_VOLUME_UNITS=10
# --- account-wide open-risk cap recalibrated to the 9-lane book (2026-08-02
# deep scan): the $40 default was sized for the XAU-only era and NEVER fired
# before the index sniper lanes existed (1 event ever, 2026-07-30, caused by
# a $57 US30 position eating the whole cap and refusing a peer's $3.7 entry).
# One healthy index position (risk $40-88 at the 1-unit floor) > $40, so the
# default would block EVERY other lane's entries whenever an index position
# is open — changing the frozen lanes' machine mid-experiment. 300 ~= the
# 9-lane worst-case book; the gate still catches true runaway stacking.
Environment=DEXTER3_ACCOUNT_MAX_OPEN_RISK_USD=300
Environment=DEXTER3_MIN_VOLUME_RISK_RATIO_CAP=0
Environment=DEXTER3_MIN_VOLUME_RISK_ABS_CAP_USD=9
Environment=DEXTER3_DAILY_TARGET_USD=15
Environment=DEXTER3_DAILY_LOSS_USD=8
Environment=DEXTER3_BASE_RISK_FRAC=0.004
Environment=DEXTER3_MAX_RISK_FRAC=0.008
# --- the proven stack (owner deploy 2026-07-16) -----------------------------
Environment=DEXTER3_VP_DAYOPEN_BIAS=1
Environment=DEXTER3_VP_BIAS_ANCHOR_HOUR=0
Environment=DEXTER3_VP_BIAS_MIN_HOURS=1
Environment=DEXTER3_VP_NO_TRADE_UTC=20:45-22:15
Environment=DEXTER3_VP_LIMIT_DIP_R=0.4
Environment=DEXTER3_VP_LIMIT_TTL_MIN=30
# owner 2026-07-16: reversal-confirm entries ONLY (zone-M1, 3-window survivor)
Environment=DEXTER3_ENTRY_CONFIRM=m1
Environment=DEXTER3_VP_FAR_TP_R=12
Environment=DEXTER3_OM_TRAIL_MODE=convex
Environment=DEXTER3_OM_CONVEX_ARM_R=1.0
Environment=DEXTER3_OM_CONVEX_GIVEBACK_ATR=3.0
Environment=DEXTER3_OM_CONVEX_GIVEBACK_MAX_PEAK_FRAC=0.5
Environment=DEXTER3_OM_CONVEX_MAX_AGE_MIN=240
# basket cap must outlive the convex 240min hold (default 180 would cap first)
Environment=DEXTER3_BASKET_TIME_STOP_MIN=250
Environment=DEXTER3_MAX_ENTRIES_PER_DAY=20
Environment=DEXTER3_DAILY_LOSS_BASKETS=3
# hunt-lane machinery not in the proof: off for this lane
Environment=DEXTER3_SMART_EXIT_ENABLED=0
Environment=DEXTER3_REPAIR_HARVEST=off
Environment=DEXTER3_PA_EYE=off
Environment=DEXTER3_WEEKEND_FLATTEN_ENABLED=1
Environment=DEXTER3_GOVERNOR_TARGET_IGNORES_FLOATING=1
Environment=DEXTER3_MIN_VOLUME_RISK_ABS_CAP_MULT=1.6
Environment=DEXTER3_LANE_INTENT_KEEP_UNEXPIRED=1
Environment=DEXTER3_MARKET_STATE_GATE=1
Environment=DEXTER3_CROSS_LANE_DEDUP=downsize
ExecStart=/opt/dexter_pro/.venv/bin/python -X utf8 -m dexter3.shadow_runner --symbols XAUUSD --loop --poll-sec 20 --live

[Install]
WantedBy=multi-user.target
