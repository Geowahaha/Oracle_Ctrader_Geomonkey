# Dexter3 SCALP lane — grok's successor (owner orders 2026-07-17: "ผ่าตัด grok
# ให้อยู่หมัด... V.1.0 original ยังทำงานดีกว่า" + "ผล bank ออกมายัง ถ้าผ่าน เปิด
# scalp lane เลย").
#
# grok was retired 2026-07-17 (3 days -35.87 USD / 92 trades, WR 27-30% with
# winner-capping scalp locks = the anti-scalp). This lane is the measured
# replacement: sdzone producer (the owner's S/D indicator: sweep +
# displacement + volume) x day-open bias x v1.0 BANK-GREEN exits (close-based
# take at +0.4R, 60min cap — the harvester-proven scalp posture).
# Verdict (no-overlap, 3 windows): 6k +3.87/+3.64, 10k -0.97/+7.46 (WR 87.5),
# 14k +1.11/+7.52 — 5/6 cells positive, worst ~breakeven, WR 81-87% =
# เข้าไว ออกไว เก็บกำไรไว. sdzone was MOVED here from the daytrend lane
# (never duplicated — the grok/fable twin disease).
[Unit]
Description=Dexter3 SCALP lane LIVE canary (sdzone x bias x bank-green)
After=network-online.target dexter3-openapi-daemon.service
Wants=dexter3-openapi-daemon.service

[Service]
Type=simple
WorkingDirectory=/opt/dexter_pro
MemoryMax=200M
Restart=always
RestartSec=15
Environment=PYTHONUNBUFFERED=1
Environment=DEXTER3_TRANSPORT=openapi
Environment=DEXTER3_OPENAPI_DAEMON_URL=http://127.0.0.1:9877
Environment=DEXTER3_LIVE=1
Environment=DEXTER3_MODE=scalp
Environment=DEXTER3_FAST_TICK_SEC=8
Environment=DEXTER3_CAPITAL_USD=1000
Environment=DEXTER3_MAX_VOLUME_UNITS=10
Environment=DEXTER3_MIN_VOLUME_RISK_RATIO_CAP=0
Environment=DEXTER3_MIN_VOLUME_RISK_ABS_CAP_USD=12
# canary risk
Environment=DEXTER3_DAILY_TARGET_USD=15
Environment=DEXTER3_DAILY_LOSS_USD=8
Environment=DEXTER3_BASE_RISK_FRAC=0.004
Environment=DEXTER3_MAX_RISK_FRAC=0.008
Environment=DEXTER3_MAX_ENTRIES_PER_DAY=20
Environment=DEXTER3_DAILY_LOSS_BASKETS=3
# the proven stack: bias gate + bank exits + scalp time cap
Environment=DEXTER3_VP_DAYOPEN_BIAS=1
Environment=DEXTER3_VP_BIAS_ANCHOR_HOUR=0
Environment=DEXTER3_VP_BIAS_MIN_HOURS=1
Environment=DEXTER3_VP_NO_TRADE_UTC=20:45-22:15
Environment=DEXTER3_OM_TRAIL_MODE=bank
Environment=DEXTER3_OM_BANK_R=0.4
Environment=DEXTER3_BASKET_TIME_STOP_MIN=60
# lane hygiene
Environment=DEXTER3_SMART_EXIT_ENABLED=0
Environment=DEXTER3_REPAIR_HARVEST=off
Environment=DEXTER3_PA_EYE=off
Environment=DEXTER3_WEEKEND_FLATTEN_ENABLED=1
Environment=DEXTER3_MARKET_STATE_GATE=1
Environment=DEXTER3_CROSS_LANE_DEDUP=downsize
ExecStart=/opt/dexter_pro/.venv/bin/python -X utf8 -m dexter3.shadow_runner --symbols XAUUSD --loop --poll-sec 20 --live

[Install]
WantedBy=multi-user.target
